# Deployment Dockerfile for anheyu-app on Render's free tier.
#
#   stage 1 (frontend-builder) -> npm ci + next build  => .next/standalone
#   stage 2 (backend-builder)  -> compile the Go binary
#   stage 3 (runtime)          -> alpine + node + ffmpeg, frontend at /anheyu/frontend
#
# The Go backend reverse-proxies the Next.js standalone server. `launcher.go`
# resolves the frontend at $ANHEYU_FRONTEND_DIR (default ./frontend, i.e.
# /anheyu/frontend) and runs `node server.js` from there, so the standalone
# bundle must land in that directory inside the image.

# ---------------- Stage 1: Next.js frontend ----------------
FROM node:20-alpine AS frontend-builder

WORKDIR /build/frontend

ENV NEXT_TELEMETRY_DISABLED=1

# Install dependencies first so the layer caches across code changes
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY frontend/ ./
# next.config.ts sets output: "standalone"
RUN npm run build

# ---------------- Stage 2: Go backend ----------------
FROM golang:1.25-alpine AS backend-builder

ARG VERSION=unknown
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath \
      -ldflags "-X 'github.com/anzhiyu-c/anheyu-app/internal/pkg/version.Version=${VERSION}' \
                -X 'github.com/anzhiyu-c/anheyu-app/internal/pkg/version.Commit=${COMMIT}' \
                -X 'github.com/anzhiyu-c/anheyu-app/internal/pkg/version.Date=${BUILD_DATE}'" \
      -o /build/anheyu-app .

# ---------------- Stage 3: runtime ----------------
FROM alpine:3.20 AS runtime

RUN apk update \
 && apk add --no-cache tzdata vips-tools ffmpeg libheif libraw-tools nodejs npm su-exec ca-certificates \
 && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /anheyu

RUN addgroup --system --gid 1001 anheyu \
 && adduser --system --uid 1001 anheyu \
 && mkdir -p ./themes ./data ./frontend

COPY --from=backend-builder /build/anheyu-app ./anheyu-app

# Next.js standalone bundle: server.js + minimal node_modules
COPY --from=frontend-builder /build/frontend/.next/standalone/ ./frontend/
# Static chunks and public assets are NOT part of standalone; copy them in.
COPY --from=frontend-builder /build/frontend/.next/static/     ./frontend/.next/static/
COPY --from=frontend-builder /build/frontend/public/           ./frontend/public/

COPY default_files ./default-data
COPY entrypoint.sh ./entrypoint.sh

RUN chmod +x ./anheyu-app ./entrypoint.sh \
 && chown -R anheyu:anheyu /anheyu

ENV AN_SETTING_DEFAULT_ENABLE_FFMPEG_GENERATOR=true \
    AN_SETTING_DEFAULT_ENABLE_VIPS_GENERATOR=true \
    AN_SETTING_DEFAULT_ENABLE_LIBRAW_GENERATOR=true \
    NODE_ENV=production \
    ANHEYU_FRONTEND_DIR=/anheyu/frontend \
    ANHEYU_FRONTEND_PORT=3000

EXPOSE 10000

ENTRYPOINT ["./entrypoint.sh"]
CMD ["./anheyu-app"]
